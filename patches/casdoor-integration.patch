+func TestEvaluationProtectedClaims(t *testing.T) {
+	protocol := Claims{User: &User{Name: "reader", Properties: map[string]string{"iss": "override", "aud": "override", "scope": "override"}}, TokenType: "access-token", Scope: "read", RegisteredClaims: jwt.RegisteredClaims{Issuer: "https://issuer.example", Subject: "subject", Audience: []string{"client"}, ExpiresAt: jwt.NewNumericDate(time.Now().Add(time.Hour))}}
+	attrs := []*JwtItem{}
+	for _, name := range []string{"iss", "sub", "aud", "exp", "nbf", "iat", "jti", "tokenType", "azp", "nonce", "scope", "cnf"} {
+		attrs = append(attrs, &JwtItem{Name: name, Type: "String", Value: "override"})
+	}
+	result := getClaimsCustom(protocol, []string{"Properties.iss", "Properties.aud", "Properties.scope"}, attrs)
+	if result["iss"] != protocol.Issuer || result["sub"] != protocol.Subject || !reflect.DeepEqual(result["aud"], protocol.Audience) || result["exp"] != protocol.ExpiresAt || result["tokenType"] != "access-token" || result["scope"] != "read" {
+		t.Fatal("protocol claim overwritten")
+	}
+	if _, ok := result["cnf"]; ok {
+		t.Fatal("confirmation claim injected")
+	}
+}
