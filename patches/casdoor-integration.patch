+)
+
+func evaluationSigningFixture(t *testing.T) (map[string]*rsa.PrivateKey, *Application) {
+	t.Helper()
+	engine, err := xorm.NewEngine("sqlite", t.TempDir()+"/signing.sqlite")
+	if err != nil {
+		t.Fatal(err)
+	}
+	engine.SetMaxOpenConns(1)
+	if err := engine.Sync2(&Cert{}, &Token{}); err != nil {
+		t.Fatal(err)
+	}
+	previous := ormer
+	ormer = &Ormer{Engine: engine}
+	t.Cleanup(func() { ormer = previous; engine.Close() })
+	keys := map[string]*rsa.PrivateKey{}
+	for _, name := range []string{"previous", "current", "untrusted"} {
+		key, err := rsa.GenerateKey(rand.Reader, 2048)
+		if err != nil {
+			t.Fatal(err)
+		}
+		public, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
+		if err != nil {
+			t.Fatal(err)
+		}
+		cert := &Cert{Owner: "admin", Name: name, Scope: "JWT", Type: "x509", CryptoAlgorithm: "RS256",
+			Certificate: string(pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: public}))}
+		if _, err := engine.Insert(cert); err != nil {
+			t.Fatal(err)
+		}
+		keys[name] = key
+	}
+	app := &Application{Owner: "admin", Name: "client", Organization: "tenant", Cert: "current", TokenSigningMethod: "RS256"}
+	configuration := map[string]interface{}{"retainedSigningCerts": []map[string]interface{}{{"cert": "admin/previous", "expiresAt": time.Now().Add(time.Hour).Unix()}}}
+	raw, _ := json.Marshal(configuration)
+	if err := json.Unmarshal(raw, app); err != nil {
+		t.Fatal(err)
+	}
+	return keys, app
+}
+
+func evaluationSignedToken(t *testing.T, key *rsa.PrivateKey, kid string, method jwt.SigningMethod) string {
+	t.Helper()
+	token := jwt.NewWithClaims(method, &Claims{User: &User{Name: "reader"}, TokenType: "access-token",
+		RegisteredClaims: jwt.RegisteredClaims{Issuer: "https://issuer.example", Subject: "subject", Audience: []string{"client"},
+			ExpiresAt: jwt.NewNumericDate(time.Now().Add(time.Hour))}})
+	if kid != "" {
+		token.Header["kid"] = kid
+	}
+	value, err := token.SignedString(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
+
+func TestEvaluationRetainedSigningKeyVerifiesOldGrant(t *testing.T) {
+	keys, app := evaluationSigningFixture(t)
+	value := evaluationSignedToken(t, keys["previous"], "previous", jwt.SigningMethodRS256)
+	if _, err := ParseJwtTokenByApplication(value, app); err != nil {
+		t.Fatalf("retained signing key must verify the old grant: %v", err)
+	}
+	if _, err := ParseStandardJwtTokenByApplication(value, app); err != nil {
+		t.Fatalf("standard token must use the same retained trust policy: %v", err)
+	}
+}
+
+func TestEvaluationRetainedSigningKeyBoundaries(t *testing.T) {
+	keys, app := evaluationSigningFixture(t)
+	old := evaluationSignedToken(t, keys["previous"], "previous", jwt.SigningMethodRS256)
+	parsers := map[string]func(string, *Application) error{
+		"custom":   func(v string, a *Application) error { _, e := ParseJwtTokenByApplication(v, a); return e },
+		"standard": func(v string, a *Application) error { _, e := ParseStandardJwtTokenByApplication(v, a); return e },
+	}
+	for format, parse := range parsers {
+		t.Run(format, func(t *testing.T) {
+			for _, tc := range []struct {
+				name, token string
+				policy      []*RetainedSigningCert
+			}{
+				{"not-retained", old, nil},
+				{"expired", old, []*RetainedSigningCert{{Cert: "admin/previous", ExpiresAt: time.Now().Unix()}}},
+				{"retired", old, []*RetainedSigningCert{}},
+				{"wrong-owner", old, []*RetainedSigningCert{{Cert: "other/previous", ExpiresAt: time.Now().Add(time.Hour).Unix()}}},
+				{"missing-cert", old, []*RetainedSigningCert{{Cert: "tenant/previous", ExpiresAt: time.Now().Add(time.Hour).Unix()}}},
+				{"unknown-kid", evaluationSignedToken(t, keys["untrusted"], "untrusted", jwt.SigningMethodRS256), app.RetainedSigningCerts},
+				{"missing-kid", evaluationSignedToken(t, keys["previous"], "", jwt.SigningMethodRS256), app.RetainedSigningCerts},
+				{"forged-signature", evaluationSignedToken(t, keys["untrusted"], "previous", jwt.SigningMethodRS256), app.RetainedSigningCerts},
+				{"wrong-algorithm", evaluationSignedToken(t, keys["previous"], "previous", jwt.SigningMethodRS512), app.RetainedSigningCerts},
+			} {
+				t.Run(tc.name, func(t *testing.T) {
+					a := *app
+					a.RetainedSigningCerts = tc.policy
+					if parse(tc.token, &a) == nil {
+						t.Fatal("unauthorized signing key accepted")
+					}
+				})
+			}
+			current := evaluationSignedToken(t, keys["current"], "current", jwt.SigningMethodRS256)
+			if parse(current, app) != nil {
+				t.Fatal("current key rejected")
+			}
+			if _, err := ormer.Engine.Where("owner = ? AND name = ?", "admin", "previous").Delete(&Cert{}); err != nil {
+				t.Fatal(err)
+			}
+			if parse(old, app) == nil {
+				t.Fatal("deleted retained key accepted")
+			}
+			if parse(current, app) != nil {
+				t.Fatal("deleted retained key disrupted current-key verification")
+			}
+		})
+		// Restore the fixture for the other claims format.
+		if _, err := ormer.Engine.Insert(&Cert{Owner: "admin", Name: "previous", Scope: "JWT", Type: "x509", Certificate: func() string {
+			p, _ := x509.MarshalPKIXPublicKey(&keys["previous"].PublicKey)
+			return string(pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: p}))
+		}()}); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestEvaluationStoredGrantApplicationBinding(t *testing.T) {
+	keys, app := evaluationSigningFixture(t)
+	access := evaluationSignedToken(t, keys["previous"], "previous", jwt.SigningMethodRS256)
+	refreshJWT := jwt.NewWithClaims(jwt.SigningMethodRS256, &Claims{User: &User{Name: "reader"}, TokenType: "refresh-token", RegisteredClaims: jwt.RegisteredClaims{ExpiresAt: jwt.NewNumericDate(time.Now().Add(time.Hour))}})
+	refreshJWT.Header["kid"] = "previous"
+	refresh, err := refreshJWT.SignedString(keys["previous"])
+	if err != nil {
+		t.Fatal(err)
+	}
+	grant := &Token{Owner: app.Owner, Name: "grant", Application: app.Name, Organization: app.Organization, User: "reader", ExpiresIn: 300,
+		AccessTokenHash: getTokenHash(access), RefreshTokenHash: getTokenHash(refresh)}
+	if _, err := ormer.Engine.Insert(grant); err != nil {
+		t.Fatal(err)
+	}
+	for _, hint := range []string{"", "access_token", "refresh_token", "unsupported"} {
+		for _, value := range []string{access, refresh} {
+			got, err := GetApplicationToken(value, hint, app)
+			if err != nil || got == nil {
+				t.Fatalf("hint must not control token admission: %q", hint)
+			}
+		}
+	}
+	for _, field := range []string{"owner", "application", "organization"} {
+		other := *app
+		switch field {
+		case "owner":
+			other.Owner = "other"
+		case "application":
+			other.Name = "other"
+		case "organization":
+			other.Organization = "other"
+		}
+		if got, err := GetApplicationToken(access, "", &other); err != nil || got != nil {
+			t.Fatalf("wrong %s accepted", field)
+		}
+	}
+	grant.ExpiresIn = 0
+	if _, err := ormer.Engine.Where("name = ?", "grant").Cols("expires_in").Update(grant); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := GetApplicationToken(access, "", app); err != nil || got != nil {
+		t.Fatal("revoked stored grant accepted")
+	}
+}
