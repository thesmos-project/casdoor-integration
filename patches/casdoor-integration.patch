+package scim
+
+import (
+	"strings"
+
+	"github.com/casdoor/casdoor/object"
+	"github.com/elimity-com/scim/errors"
+	"github.com/scim2/filter-parser/v2"
+	"github.com/xorm-io/xorm"
+)
+
+// Only supported equality expressions reach SQL; unsupported filters fail closed.
+func listFilter(exp filter.Expression, schemaURI string, columns map[string]string) (string, string, error) {
+	if exp == nil {
+		return "", "", nil
+	}
+	attr, ok := exp.(*filter.AttributeExpression)
+	if !ok || attr.Operator != filter.EQ || attr.AttributePath.SubAttribute != nil {
+		return "", "", errors.ScimErrorInvalidFilter
+	}
+	uri := attr.AttributePath.URI()
+	if uri != "" && !strings.EqualFold(uri, schemaURI) {
+		return "", "", errors.ScimErrorInvalidFilter
+	}
+	column, ok := columns[strings.ToLower(attr.AttributePath.AttributeName)]
+	value, isString := attr.CompareValue.(string)
+	if !ok || !isString {
+		return "", "", errors.ScimErrorInvalidFilter
+	}
+	if strings.HasPrefix(column, "LOWER(") {
+		value = strings.ToLower(value)
+	}
+	return column, value, nil
+}
+
+func listSession(organization, column, value string) *xorm.Session {
+	session := object.GetSession(organization, -1, -1, "", "", "name", "ascend").Asc("owner")
+	if column != "" {
+		session = session.And(column+" = ?", value)
+	}
+	return session
+}
