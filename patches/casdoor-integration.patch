+func TestEvaluationRefreshClaimsExcludeApplicationClaims(t *testing.T) {
+	expiry := time.Now().Add(time.Hour)
+	claims := Claims{User: &User{Name: "reader"}, Scope: "read", TokenType: "access-token", RegisteredClaims: jwt.RegisteredClaims{Issuer: "https://issuer.example", Subject: "subject"}}
+	result := getRefreshClaimsCustom(claims, []string{"Name"}, []*JwtItem{{Name: "roles", Type: "Array", Value: "reader"}}, expiry)
+	if _, ok := result["roles"]; ok {
+		t.Fatal("application role claim in refresh token")
+	}
+	encoded, err := json.Marshal(result)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var parsed Claims
+	if err := json.Unmarshal(encoded, &parsed); err != nil {
+		t.Fatal(err)
+	}
+	if parsed.Scope != "read" || parsed.TokenType != "refresh-token" || parsed.Subject != "subject" || parsed.ExpiresAt.Unix() != expiry.Unix() {
+		t.Fatal("refresh protocol claims lost")
+	}
+}
