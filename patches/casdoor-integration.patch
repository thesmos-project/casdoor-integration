+package object
+
+import (
+	"errors"
+	"strings"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+)
+
+const maxRetainedSigningCerts = 2
+const maxRetainedSigningLifetime = 24 * time.Hour
+
+// RetainedSigningCert authorizes verification, never issuance, for one exact
+// certificate until an absolute Unix-second deadline. Only global operators
+// can change this policy through the application API.
+type RetainedSigningCert struct {
+	Cert      string `json:"cert"`
+	ExpiresAt int64  `json:"expiresAt"`
+}
+
+func retainedSigningCertIdentity(entry *RetainedSigningCert, application *Application) (string, string, error) {
+	if entry == nil {
+		return "", "", errors.New("retained signing certificate entry is missing")
+	}
+	parts := strings.Split(entry.Cert, "/")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" || len(parts[0]) > 100 || len(parts[1]) > 100 ||
+		(parts[0] != application.Owner && parts[0] != application.Organization) {
+		return "", "", errors.New("retained signing certificate requires an explicit authorized owner/name")
+	}
+	return parts[0], parts[1], nil
+}
+
+func validateRetainedSigningCerts(application *Application, now time.Time) error {
+	if len(application.RetainedSigningCerts) > maxRetainedSigningCerts {
+		return errors.New("at most two retained signing certificates are allowed")
+	}
+	if len(application.RetainedSigningCerts) == 0 {
+		return nil
+	}
+	current, err := getCertByApplication(application)
+	if err != nil || current == nil || current.Scope != "JWT" || current.Certificate == "" {
+		return errors.New("current signing certificate is unavailable")
+	}
+	seen := map[string]bool{current.Name: true}
+	for _, entry := range application.RetainedSigningCerts {
+		owner, name, err := retainedSigningCertIdentity(entry, application)
+		if err != nil {
+			return err
+		}
+		if entry.ExpiresAt <= 0 || entry.ExpiresAt > now.Add(maxRetainedSigningLifetime).Unix() {
+			return errors.New("retained signing certificate deadline must be positive and within 24 hours")
+		}
+		if seen[name] {
+			return errors.New("signing certificate key IDs must be distinct")
+		}
+		seen[name] = true
+		cert, err := getCert(owner, name) // Exact identity; no global-name fallback.
+		if err != nil || cert == nil || cert.Scope != "JWT" || cert.Certificate == "" {
+			return errors.New("retained JWT signing certificate is unavailable")
+		}
+	}
+	return nil
+}
+
+func getTokenVerificationCert(tokenValue string, application *Application) (*Cert, error) {
+	current, err := getCertByApplication(application)
+	if err != nil || current == nil || current.Certificate == "" {
+		return nil, errors.New("current signing certificate is unavailable")
+	}
+	// Preserve the default single-key policy, including existing keyless refresh
+	// tokens. Opt-in overlap requires a kid; newly issued refresh tokens carry it.
+	if len(application.RetainedSigningCerts) == 0 {
+		return current, nil
+	}
+	if len(application.RetainedSigningCerts) > maxRetainedSigningCerts {
+		return nil, errors.New("invalid retained signing certificate policy")
+	}
+	unverified, _, err := jwt.NewParser().ParseUnverified(tokenValue, jwt.MapClaims{})
+	if err != nil {
+		return nil, errors.New("invalid JWT header")
+	}
+	kid, ok := unverified.Header["kid"].(string)
+	algorithm := application.TokenSigningMethod
+	if algorithm == "" {
+		algorithm = "RS256"
+	}
+	if !ok || kid == "" || len(kid) > 100 || unverified.Method.Alg() != algorithm {
+		return nil, errors.New("JWT key ID or signing algorithm is not authorized")
+	}
+	if kid == current.Name {
+		return current, nil
+	}
+	now := time.Now()
+	for _, entry := range application.RetainedSigningCerts {
+		owner, name, err := retainedSigningCertIdentity(entry, application)
+		if err != nil {
+			return nil, err
+		}
+		if name != kid {
+			continue
+		}
+		if entry.ExpiresAt <= now.Unix() || entry.ExpiresAt > now.Add(maxRetainedSigningLifetime).Unix() {
+			return nil, errors.New("retained signing certificate is expired or invalid")
+		}
+		cert, err := getCert(owner, name) // Lookup is driven by trusted configuration.
+		if err != nil || cert == nil || cert.Scope != "JWT" || cert.Certificate == "" {
+			return nil, errors.New("retained JWT signing certificate is unavailable")
+		}
+		return cert, nil
+	}
+	return nil, errors.New("JWT signing key is not authorized for this application")
+}
+
+func tokenBelongsToApplication(token *Token, application *Application) bool {
+	return token != nil && application != nil && token.Owner == application.Owner &&
+		token.Application == application.Name && token.Organization == application.Organization
+}
+
+// GetApplicationToken binds introspection to the authenticated application
+// before any untrusted JWT header participates in key selection.
+func GetApplicationToken(tokenValue, hint string, application *Application) (*Token, error) {
+	token, err := GetTokenByTokenValue(tokenValue, hint)
+	if err != nil {
+		return nil, err
+	}
+	if token == nil || token.ExpiresIn <= 0 || !tokenBelongsToApplication(token, application) {
+		return nil, nil
+	}
+	return token, nil
+}
