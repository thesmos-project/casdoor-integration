+
+package scim
+
+import (
+	"github.com/casdoor/casdoor/object"
+	"github.com/casdoor/casdoor/util"
+	"github.com/elimity-com/scim"
+	"github.com/scim2/filter-parser/v2"
+	"testing"
+)
+
+func TestEvaluationActiveMapping(t *testing.T) {
+	for _, active := range []bool{true, false} {
+		user, err := resource2user(scim.ResourceAttributes{"userName": "reader", "active": active, UserExtensionKey: map[string]interface{}{"organization": "evaluation"}})
+		if err != nil || user.IsForbidden == active {
+			t.Fatalf("active mapping failed: %v", err)
+		}
+		if user2resource(user).Attributes["active"] != active {
+			t.Fatal("active did not round trip")
+		}
+	}
+	for _, value := range []interface{}{nil, "false", 0} {
+		if _, err := resource2user(scim.ResourceAttributes{"active": value}); err == nil {
+			t.Fatal("nonboolean active accepted")
+		}
+	}
+	if user2resource(&object.User{IsDeleted: true}).Attributes["active"] != false {
+		t.Fatal("deleted user active")
+	}
+}
+
+func TestEvaluationSCIMFilter(t *testing.T) {
+	for _, tc := range []struct {
+		input     string
+		supported bool
+	}{
+		{`userName eq "reader"`, true},
+		{`USERNAME eq "READER"`, true},
+		{`userName eq "x' OR 1=1 --"`, true},
+		{`userName co "reader"`, false},
+		{`userName eq "reader" or userName eq "admin"`, false},
+		{`active eq false`, false},
+		{`urn:ietf:params:scim:schemas:extension:enterprise:2.0:User:userName eq "reader"`, false},
+	} {
+		exp, err := filter.ParseFilter([]byte(tc.input))
+		if err != nil {
+			t.Fatal(err)
+		}
+		column, value, err := listFilter(exp, "urn:ietf:params:scim:schemas:core:2.0:User", map[string]string{"username": "LOWER(name)"})
+		if (err == nil) != tc.supported {
+			t.Fatalf("unexpected filter support for %s: %v", tc.input, err)
+		}
+		if tc.supported && (column != "LOWER(name)" || value == "") {
+			t.Fatal("incorrect filter translation")
+		}
+	}
+}
+
+func TestEvaluationSCIMGroupExternalID(t *testing.T) {
+	group, err := resource2group(scim.ResourceAttributes{"displayName": "bridge-group", "externalId": "bridge-ownership", GroupExtensionKey: map[string]interface{}{"organization": "evaluation"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	group.CreatedTime = util.GetCurrentTime()
+	resource := group2resource(group, nil)
+	if resource.ExternalID.Value() != "bridge-ownership" {
+		t.Fatal("group ownership identity did not round trip")
+	}
+	group.Properties = nil
+	if group2resource(group, nil).ExternalID.Present() {
+		t.Fatal("absent externalId was advertised")
+	}
+}
