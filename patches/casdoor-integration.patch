+func TestEvaluationPersistentSAMLNameID(t *testing.T) {
+	app := &Application{UsePersistentSamlNameId: true, UseEmailAsSamlNameId: true}
+	first := &User{Id: "immutable-first", Name: "same-name", Email: "first@example.invalid"}
+	id, format := getSamlNameId(app, first)
+	if id != first.Id || format != "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent" {
+		t.Fatal("persistent subject not used")
+	}
+	first.Name = "renamed"
+	first.Email = "changed@example.invalid"
+	if renamed, _ := getSamlNameId(app, first); renamed != id {
+		t.Fatal("profile change changed persistent subject")
+	}
+	replacement := &User{Id: "immutable-replacement", Name: "same-name"}
+	if value, _ := getSamlNameId(app, replacement); value == id {
+		t.Fatal("recreated account reused subject")
+	}
+	if value, _ := getSamlNameId(app, &User{Name: "fallback"}); value != "" {
+		t.Fatal("missing immutable id fell back to mutable name")
+	}
+	if value, _ := getSamlNameId(&Application{}, &User{Name: "upstream-default"}); value != "upstream-default" {
+		t.Fatal("upstream default changed without opt-in")
+	}
+}
