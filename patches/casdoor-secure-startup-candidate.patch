+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package object
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/casdoor/casdoor/cred"
+	"github.com/xorm-io/xorm"
+)
+
+func secureStartupFixture(t *testing.T, password string) {
+	t.Helper()
+	engine, err := xorm.NewEngine("sqlite", t.TempDir()+"/startup.sqlite")
+	if err != nil {
+		t.Fatal(err)
+	}
+	previous := ormer
+	ormer = &Ormer{Engine: engine}
+	t.Cleanup(func() { ormer = previous; engine.Close() })
+	if err := engine.Sync2(&User{}, &Organization{}, &Syncer{}); err != nil {
+		t.Fatal(err)
+	}
+	organization := &Organization{Owner: "admin", Name: "built-in", PasswordType: "bcrypt"}
+	if _, err := engine.Insert(organization); err != nil {
+		t.Fatal(err)
+	}
+	user := &User{Owner: "built-in", Name: "admin", Id: "admin-id", Password: password, IsAdmin: true}
+	user.UpdateUserPassword(organization)
+	if _, err := engine.Insert(user); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func adminPasswordIs(t *testing.T, password string) bool {
+	t.Helper()
+	user, err := getUser("built-in", "admin")
+	if err != nil || user == nil {
+		t.Fatal("built-in administrator missing")
+	}
+	return cred.GetCredManager(user.PasswordType).IsPasswordCorrect(password, user.Password, user.PasswordSalt)
+}
+
+func writeSecret(t *testing.T, value string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "admin-password")
+	if err := os.WriteFile(path, []byte(value), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestEvaluationSecureStartupRefusesUnsafeSettings(t *testing.T) {
+	secret := "correct-horse-battery-staple"
+	valid := SecureStartupOptions{Enabled: true, RunMode: "prod", AdminPasswordFile: writeSecret(t, secret+"\n")}
+	for _, tc := range []struct {
+		name   string
+		change func(*SecureStartupOptions)
+		error  string
+	}{
+		{"missing secret", func(o *SecureStartupOptions) { o.AdminPasswordFile = "" }, "default password"},
+		{"unreadable secret", func(o *SecureStartupOptions) { o.AdminPasswordFile = filepath.Join(t.TempDir(), "absent") }, "not readable"},
+		{"short secret", func(o *SecureStartupOptions) { o.AdminPasswordFile = writeSecret(t, "short") }, "at least"},
+		{"whitespace secret", func(o *SecureStartupOptions) { o.AdminPasswordFile = writeSecret(t, " "+strings.Repeat("a", 20)) }, "whitespace"},
+		{"development mode", func(o *SecureStartupOptions) { o.RunMode = "dev" }, "runmode"},
+		{"default RADIUS secret", func(o *SecureStartupOptions) { o.RadiusPort, o.RadiusSecret = "1812", "secret" }, "radiusSecret"},
+		{"missing initialization file", func(o *SecureStartupOptions) { o.InitDataFile = filepath.Join(t.TempDir(), "init.json") }, "initDataFile"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			secureStartupFixture(t, "123")
+			options := valid
+			tc.change(&options)
+			if _, err := ApplySecureStartup(options); err == nil || !strings.Contains(err.Error(), tc.error) {
+				t.Fatalf("expected refusal containing %q, got %v", tc.error, err)
+			}
+			if !adminPasswordIs(t, "123") {
+				t.Fatal("a refused startup changed the administrator password")
+			}
+		})
+	}
+}
+
+func TestEvaluationSecureStartupSetsBootstrapPasswordOnce(t *testing.T) {
+	secureStartupFixture(t, "123")
+	first := "first-unique-bootstrap-secret"
+	options := SecureStartupOptions{Enabled: true, RunMode: "prod", RadiusPort: "", AdminPasswordFile: writeSecret(t, first+"\n")}
+	notices, err := ApplySecureStartup(options)
+	if err != nil || len(notices) != 1 || strings.Contains(notices[0], first) {
+		t.Fatalf("bootstrap failed or logged the secret: %v %v", notices, err)
+	}
+	if !adminPasswordIs(t, first) || adminPasswordIs(t, "123") {
+		t.Fatal("bootstrap secret not applied")
+	}
+	options.AdminPasswordFile = writeSecret(t, "second-unique-bootstrap-secret")
+	if _, err := ApplySecureStartup(options); err != nil || !adminPasswordIs(t, first) {
+		t.Fatalf("restart reset an administrator password that was no longer a default: %v", err)
+	}
+}
+
+func TestEvaluationSecureStartupDisabledWarnsOnly(t *testing.T) {
+	secureStartupFixture(t, "123")
+	notices, err := ApplySecureStartup(SecureStartupOptions{RunMode: "dev", RadiusPort: "1812", RadiusSecret: "secret"})
+	if err != nil || len(notices) != 1 || !strings.Contains(notices[0], "WARNING") || !adminPasswordIs(t, "123") {
+		t.Fatalf("disabled secure startup must keep upstream behavior with a warning: %v %v", notices, err)
+	}
+	secureStartupFixture(t, "already-changed-password")
+	if notices, err := ApplySecureStartup(SecureStartupOptions{Enabled: true, RunMode: "prod"}); err != nil || len(notices) != 0 {
+		t.Fatalf("a changed password must not require a bootstrap secret: %v %v", notices, err)
+	}
+}
