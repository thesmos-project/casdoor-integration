index 0000000..4db2f17
--- /dev/null
+++ b/object/thesmos_secure_startup.go
@@ -0,0 +1,127 @@
+// Copyright 2026 The Thesmos integration contributors.
+// Added for the Thesmos integration evaluation, 2026-10-07.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package object
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/casdoor/casdoor/cred"
+)
+
+// SecureStartupOptions holds the settings checked before Casdoor serves requests.
+type SecureStartupOptions struct {
+	Enabled           bool
+	AdminPasswordFile string
+	RunMode           string
+	RadiusPort        string
+	RadiusSecret      string
+	InitDataFile      string
+}
+
+const minBootstrapAdminPasswordLength = 16
+
+// Passwords created by upstream initialization and common first-run guesses.
+var knownDefaultPasswords = []string{"123", "123456", "admin", "password"}
+
+// ApplySecureStartup runs after initialization and before any listener starts.
+// While the built-in administrator still has a known default password, it sets
+// the password from AdminPasswordFile; a password already changed is never
+// reset. With Enabled, it refuses startup that would serve a default password
+// or use unsafe settings. Notices are safe to log; they never contain secrets.
+func ApplySecureStartup(options SecureStartupOptions) ([]string, error) {
+	notices := []string{}
+	if options.Enabled {
+		if options.RunMode != "prod" {
+			return notices, errors.New("secure startup requires runmode = prod")
+		}
+		if options.RadiusPort != "" && options.RadiusPort != "0" && (options.RadiusSecret == "" || options.RadiusSecret == "secret") {
+			return notices, errors.New("secure startup requires a unique radiusSecret, or an empty radiusServerPort to disable RADIUS")
+		}
+		if options.InitDataFile != "" {
+			if _, err := os.Stat(options.InitDataFile); err != nil {
+				return notices, fmt.Errorf("initDataFile %s is not readable", options.InitDataFile)
+			}
+		}
+	}
+
+	user, err := getUser("built-in", "admin")
+	if err != nil {
+		return notices, err
+	}
+	if user == nil {
+		return notices, nil
+	}
+	organization, err := getOrganization("admin", "built-in")
+	if err != nil {
+		return notices, err
+	}
+	if organization == nil {
+		return notices, errors.New("the built-in organization is missing")
+	}
+	if !hasKnownDefaultPassword(user, organization) {
+		return notices, nil
+	}
+
+	if options.AdminPasswordFile == "" {
+		if options.Enabled {
+			return notices, fmt.Errorf("the built-in administrator has a default password; set bootstrapAdminPasswordFile to a file containing a unique password of at least %d characters", minBootstrapAdminPasswordLength)
+		}
+		return append(notices, "WARNING: the built-in administrator has a default password; change it before exposing Casdoor"), nil
+	}
+	raw, err := os.ReadFile(options.AdminPasswordFile)
+	if err != nil {
+		return notices, errors.New("bootstrapAdminPasswordFile is not readable")
+	}
+	password := strings.TrimRight(string(raw), "\r\n")
+	if len(password) < minBootstrapAdminPasswordLength || strings.TrimSpace(password) != password || isKnownDefaultPassword(password) {
+		return notices, fmt.Errorf("the bootstrap administrator password must have at least %d characters without surrounding whitespace", minBootstrapAdminPasswordLength)
+	}
+	user.Password = password
+	user.UpdateUserPassword(organization)
+	if _, err := UpdateUser(user.GetId(), user, []string{"password", "password_type", "password_salt"}, true); err != nil {
+		return notices, err
+	}
+	return append(notices, "The built-in administrator password was set from bootstrapAdminPasswordFile."), nil
+}
+
+func isKnownDefaultPassword(password string) bool {
+	for _, known := range knownDefaultPasswords {
+		if password == known {
+			return true
+		}
+	}
+	return false
+}
+
+func hasKnownDefaultPassword(user *User, organization *Organization) bool {
+	passwordType := user.PasswordType
+	if passwordType == "" {
+		passwordType = organization.PasswordType
+	}
+	credManager := cred.GetCredManager(passwordType)
+	if credManager == nil {
+		return false
+	}
+	for _, known := range knownDefaultPasswords {
+		if credManager.IsPasswordCorrect(known, user.Password, organization.PasswordSalt) || credManager.IsPasswordCorrect(known, user.Password, user.PasswordSalt) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/object/thesmos_secure_startup_test.go b/object/thesmos_secure_startup_test.go
new file mode 100644
index 0000000..9364665
--- /dev/null
+++ b/object/thesmos_secure_startup_test.go
@@ -0,0 +1,126 @@
+// Copyright 2026 The Thesmos integration contributors.
+// Added for the Thesmos integration evaluation, 2026-10-07.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
