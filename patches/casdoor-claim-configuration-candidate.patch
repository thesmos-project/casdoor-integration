+package object
+
+import (
+	"encoding/json"
+
+	"github.com/xorm-io/xorm"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestEvaluationClaimConfiguration(t *testing.T) {
+	attribute := func(name, category, kind, value string) *Application {
+		return &Application{TokenAttributes: []*JwtItem{{Name: name, Category: category, Type: kind, Value: value}}}
+	}
+	cases := []struct {
+		name  string
+		app   *Application
+		valid bool
+	}{
+		{"empty", &Application{}, true},
+		{"namespaced JSON", attribute("https://api.example/roles", "Static Value", "JSON", `{"roles":["reader"],"enabled":true}`), true},
+		{"array template", attribute("groups", "Static Value", "Array", "$user.groups"), true},
+		{"boolean field", attribute("email_verified", "Existing Field", "String", "EmailVerified"), true},
+		{"field property", attribute("custom", "Existing Field", "String", "Properties.my_key"), true},
+		{"default category and type", attribute("custom_claim", "", "", "fixed"), true},
+		{"array as string user field", attribute("custom", "", "", "fixed"), false},
+		{"selected fields", &Application{TokenFields: []string{"Email", "Roles", "permissionNames", "signinMethod", "provider", "Properties.tenant"}}, true},
+		{"null row", &Application{TokenAttributes: []*JwtItem{nil}}, false},
+		{"empty name", attribute("", "Static Value", "String", "fixed"), false},
+		{"whitespace name", attribute(" custom", "Static Value", "String", "fixed"), false},
+		{"control name", attribute("a\nb", "Static Value", "String", "fixed"), false},
+		{"invalid UTF8", attribute(string([]byte{255}), "Static Value", "String", "fixed"), false},
+		{"long name", attribute(strings.Repeat("a", 257), "Static Value", "String", "fixed"), false},
+		{"bad JSON", attribute("custom", "Static Value", "JSON", `{"roles":`), false},
+		{"null JSON", attribute("custom", "Static Value", "JSON", `null`), true},
+		{"unknown category", attribute("custom", "Script", "String", "fixed"), false},
+		{"unknown type", attribute("custom", "Static Value", "Integer", "1"), false},
+		{"unknown source", attribute("custom", "Existing Field", "String", "EmailTypo"), false},
+		{"nested property", attribute("custom", "Existing Field", "String", "Properties.a.b"), false},
+		{"empty property", &Application{TokenFields: []string{"Properties."}}, false},
+		{"unknown selected field", &Application{TokenFields: []string{"EmailTypo"}}, false},
+		{"attribute collision", &Application{TokenAttributes: []*JwtItem{{Name: "a"}, {Name: "a"}}}, false},
+		{"field collision", &Application{TokenFields: []string{"Email", "Properties.email"}}, false},
+		{"field and attribute collision", &Application{TokenFields: []string{"Email"}, TokenAttributes: []*JwtItem{{Name: "email"}}}, false},
+		{"oversized value", attribute("custom", "Static Value", "String", strings.Repeat("a", 8193)), false},
+		{"too many fields", &Application{TokenFields: make([]string, 65)}, false},
+		{"too many attributes", &Application{TokenAttributes: make([]*JwtItem, 65)}, false},
+		{"role names as user roles", attribute("roles", "Static Value", "Array", "$user.roles"), false},
+		{"case-insensitive user field", attribute("ROLES", "Static Value", "String", "reader"), false},
+		{"existing role names as user roles", attribute("roles", "Existing Field", "Array", "Roles"), false},
+		{"string property as user groups", &Application{TokenFields: []string{"Properties.groups"}}, false},
+		{"JSON object as user groups", attribute("groups", "Static Value", "JSON", `{"reader":true}`), false},
+		{"string as boolean user field", attribute("isAdmin", "Static Value", "String", "true"), false},
+		{"JSON array as user groups", attribute("groups", "Static Value", "JSON", `["reader"]`), true},
+		{"string as user name", attribute("name", "Static Value", "String", "$user.name"), true},
+		{"existing field under its own name", attribute("email", "Existing Field", "String", "Email"), true},
+	}
+	for _, name := range []string{"iss", "sub", "aud", "exp", "nbf", "iat", "jti", "tokenType", "azp", "nonce", "scope", "cnf"} {
+		cases = append(cases, struct {
+			name  string
+			app   *Application
+			valid bool
+		}{"reserved attribute " + name, attribute(name, "Static Value", "String", "override"), false})
+		cases = append(cases, struct {
+			name  string
+			app   *Application
+			valid bool
+		}{"reserved property " + name, &Application{TokenFields: []string{"Properties." + name}}, false})
+	}
+	// Every accepted configuration must yield tokens Casdoor can decode again.
+	user := &User{Name: "reader", Email: "reader@example.invalid", Groups: []string{"evaluation/readers"},
+		Roles: []*Role{{Name: "reader"}}, Permissions: []*Permission{{Name: "read"}}, Properties: map[string]string{"tenant": "a", "my_key": "b"}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := validateCustomClaimConfiguration(tc.app)
+			if (err == nil) != tc.valid {
+				t.Fatalf("valid=%v error=%v", tc.valid, err)
+			}
+			if err != nil {
+				return
+			}
+			payload, err := json.Marshal(getClaimsCustom(Claims{User: user}, tc.app.TokenFields, tc.app.TokenAttributes))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := json.Unmarshal(payload, &Claims{}); err != nil {
+				t.Fatalf("accepted configuration issues a token Casdoor cannot decode: %v", err)
+			}
+		})
+	}
+	// Accepted literals retain native JSON types and existing fields retain their
+	// native boolean value; validation must not alter this issuance contract.
+	app := attribute("namespace", "Static Value", "JSON", `{"roles":["reader"],"enabled":true}`)
+	app.TokenAttributes = append(app.TokenAttributes, &JwtItem{Name: "email_verified", Category: "Existing Field", Type: "String", Value: "EmailVerified"})
+	if err := validateCustomClaimConfiguration(app); err != nil {
+		t.Fatal(err)
+	}
+	claims := getClaimsCustom(Claims{User: &User{EmailVerified: true}}, nil, app.TokenAttributes)
+	if !reflect.DeepEqual(claims["namespace"], map[string]interface{}{"roles": []interface{}{"reader"}, "enabled": true}) || claims["email_verified"] != true {
+		t.Fatal("accepted claim types changed")
+	}
+	getClaimsCustom(Claims{User: &User{}}, nil, []*JwtItem{nil}) // imported legacy null row must not panic
+}
+
+func TestEvaluationPartialClaimConfiguration(t *testing.T) {
+	previous := &Application{TokenFields: []string{"Email"}, TokenAttributes: []*JwtItem{{Name: "groups", Type: "Array", Value: "reader"}}}
+	cases := []struct {
+		name    string
+		app     *Application
+		columns []string
+		valid   bool
+	}{
+		{"unrelated partial ignores unpersisted malformed attributes", &Application{TokenAttributes: []*JwtItem{nil}}, []string{"display_name"}, true},
+		{"partial field update retains attributes", &Application{TokenFields: []string{"Properties.groups"}}, []string{"token_fields"}, false},
+		{"partial attribute update retains fields", &Application{TokenAttributes: []*JwtItem{{Name: "email"}}}, []string{"token_attributes"}, false},
+		{"clear attributes", &Application{}, []string{"token_attributes"}, true},
+		{"replace both", &Application{TokenFields: []string{"Email"}, TokenAttributes: []*JwtItem{{Name: "groups"}}}, []string{"token_fields", "token_attributes"}, true},
+		{"full update", &Application{TokenAttributes: []*JwtItem{{Name: "iss"}}}, nil, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := validateUpdatedCustomClaimConfiguration(tc.app, previous, tc.columns)
+			if (err == nil) != tc.valid {
+				t.Fatalf("valid=%v error=%v", tc.valid, err)
+			}
+		})
+	}
+}
+
+func TestEvaluationInvalidClaimsDoNotPersist(t *testing.T) {
+	engine, err := xorm.NewEngine("sqlite", t.TempDir()+"/claims.sqlite")
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := ormer
+	ormer = &Ormer{Engine: engine}
+	t.Cleanup(func() { ormer = old; engine.Close() })
+	if err := engine.Sync2(&Application{}, &Organization{}, &Provider{}); err != nil {
+		t.Fatal(err)
+	}
+	existing := &Application{Owner: "admin", Name: "existing", Organization: "tenant", ClientId: "client", TokenFormat: "JWT-Custom", TokenFields: []string{"Email"}}
+	if _, err := engine.Insert(existing); err != nil {
+		t.Fatal(err)
+	}
+	invalid := *existing
+	invalid.Name = "renamed"
+	invalid.TokenAttributes = []*JwtItem{{Name: "iss", Type: "String", Value: "must-not-persist"}}
+	if affected, err := UpdateApplication("admin/existing", &invalid, true, "en", nil); affected || err == nil || !strings.Contains(err.Error(), "protocol claim") {
+		t.Fatalf("invalid update: affected=%v err=%v", affected, err)
+	}
+	var stored Application
+	found, err := engine.Where("owner=? AND name=?", "admin", "existing").Get(&stored)
+	if err != nil || !found || len(stored.TokenAttributes) != 0 {
+		t.Fatal("invalid update altered stored configuration")
+	}
+	if affected, err := AddApplication(&invalid, "en"); affected || err == nil || !strings.Contains(err.Error(), "protocol claim") {
+		t.Fatalf("invalid add: affected=%v err=%v", affected, err)
+	}
+	count, err := engine.Where("owner=? AND name=?", "admin", "renamed").Count(&Application{})
+	if err != nil || count != 0 {
+		t.Fatal("invalid add persisted")
+	}
+}
+
+func TestEvaluationPartialClaimsOnlyWriteSelectedColumns(t *testing.T) {
+	engine, err := xorm.NewEngine("sqlite", t.TempDir()+"/partial.sqlite")
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := ormer
+	ormer = &Ormer{Engine: engine}
+	t.Cleanup(func() { ormer = old; engine.Close() })
+	if err := engine.Sync2(&Application{}, &Organization{}, &Provider{}); err != nil {
+		t.Fatal(err)
+	}
+	existing := &Application{Owner: "admin", Name: "existing", Organization: "tenant", ClientId: "client", TokenFormat: "JWT-Custom", TokenFields: []string{"Name"}, TokenAttributes: []*JwtItem{{Name: "groups", Type: "Array", Value: "reader"}}}
+	if _, err := engine.Insert(existing); err != nil {
+		t.Fatal(err)
+	}
+	partial := *existing
+	partial.Name = "unselected-rename"
+	partial.DisplayName = "Selected display"
+	partial.TokenAttributes = []*JwtItem{nil}
+	if affected, err := UpdateApplication("admin/existing", &partial, true, "en", []string{"display_name"}); !affected || err != nil {
+		t.Fatalf("partial update: affected=%v error=%v", affected, err)
+	}
+	var stored Application
+	found, err := engine.Where("owner=? AND name=?", "admin", "existing").Get(&stored)
+	if err != nil || !found || stored.DisplayName != partial.DisplayName || !reflect.DeepEqual(stored.TokenFields, existing.TokenFields) || !reflect.DeepEqual(stored.TokenAttributes, existing.TokenAttributes) {
+		t.Fatal("partial update changed unselected claim configuration or name")
+	}
+	partial = *existing
+	partial.TokenAttributes = nil
+	if affected, err := UpdateApplication("admin/existing", &partial, true, "en", []string{"token_attributes"}); !affected || err != nil {
+		t.Fatalf("partial clear: affected=%v error=%v", affected, err)
+	}
+	stored = Application{}
+	found, err = engine.Where("owner=? AND name=?", "admin", "existing").Get(&stored)
+	if err != nil || !found || len(stored.TokenAttributes) != 0 || !reflect.DeepEqual(stored.TokenFields, existing.TokenFields) {
+		t.Fatal("partial clear did not preserve fields and clear attributes")
+	}
+}
