diff --git a/object/thesmos_claim_configuration.go b/object/thesmos_claim_configuration.go
new file mode 100644
index 0000000..0a6227b
--- /dev/null
+++ b/object/thesmos_claim_configuration.go
@@ -0,0 +1,208 @@
+// Copyright 2026 The Thesmos integration contributors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package object
+
+import (
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/casdoor/casdoor/util"
+)
+
+// Validate the configuration before persistence. Issuance also retains its
+// protocol-claim guards, including for configurations imported outside this API.
+func validateCustomClaimConfiguration(application *Application) error {
+	if len(application.TokenFields) > 64 || len(application.TokenAttributes) > 64 {
+		return fmt.Errorf("tokenFields and tokenAttributes each allow at most 64 entries")
+	}
+	names := map[string]bool{}
+	claimName := func(name string) error {
+		if name == "" || len(name) > 256 || !utf8.ValidString(name) || strings.TrimSpace(name) != name || strings.IndexFunc(name, unicode.IsControl) >= 0 {
+			return fmt.Errorf("claim name must be 1 to 256 bytes of valid text without surrounding whitespace or control characters")
+		}
+		if isProtectedCustomClaim(name) {
+			return fmt.Errorf("protocol claim names cannot be customized")
+		}
+		if names[name] {
+			return fmt.Errorf("claim name is configured more than once")
+		}
+		names[name] = true
+		return nil
+	}
+	userField := func(field string) bool {
+		if strings.HasPrefix(field, "Properties.") {
+			key := strings.TrimPrefix(field, "Properties.")
+			return key != "" && !strings.Contains(key, ".") && len(key) <= 256 && utf8.ValidString(key) && strings.TrimSpace(key) == key && strings.IndexFunc(key, unicode.IsControl) < 0
+		}
+		if field == "permissionNames" {
+			return true
+		}
+		member, ok := reflect.TypeOf(User{}).FieldByName(field)
+		return ok && member.PkgPath == ""
+	}
+	for i, field := range application.TokenFields {
+		name := util.SnakeToCamel(util.CamelToSnakeCase(field))
+		if strings.HasPrefix(field, "Properties.") {
+			name = strings.TrimPrefix(field, "Properties.")
+		} else if field == "signinMethod" || field == "provider" {
+			name = field
+		} else if !userField(field) {
+			return fmt.Errorf("tokenFields entry %d: unknown user field", i+1)
+		}
+		if strings.HasPrefix(field, "Properties.") && !userField(field) {
+			return fmt.Errorf("tokenFields entry %d: invalid property field", i+1)
+		}
+		if err := claimName(name); err != nil {
+			return fmt.Errorf("tokenFields entry %d: %w", i+1, err)
+		}
+		if err := checkClaimDecodes(name, tokenFieldSample(field)); err != nil {
+			return fmt.Errorf("tokenFields entry %d: %w", i+1, err)
+		}
+	}
+	for i, item := range application.TokenAttributes {
+		if item == nil {
+			return fmt.Errorf("tokenAttributes entry %d: entry cannot be null", i+1)
+		}
+		if err := claimName(item.Name); err != nil {
+			return fmt.Errorf("tokenAttributes entry %d: %w", i+1, err)
+		}
+		switch item.Category {
+		case "", "Static Value", "Existing Field":
+		default:
+			return fmt.Errorf("tokenAttributes entry %d: unknown category", i+1)
+		}
+		switch item.Type {
+		case "", "String", "Array", "JSON":
+		default:
+			return fmt.Errorf("tokenAttributes entry %d: unknown type", i+1)
+		}
+		if len(item.Value) > 8192 {
+			return fmt.Errorf("tokenAttributes entry %d: value exceeds 8192 bytes", i+1)
+		}
+		if item.Category == "Existing Field" {
+			if !userField(item.Value) {
+				return fmt.Errorf("tokenAttributes entry %d: unknown user field", i+1)
+			}
+		} else if item.Type == "JSON" && !json.Valid([]byte(item.Value)) {
+			return fmt.Errorf("tokenAttributes entry %d: invalid JSON value", i+1)
+		}
+		if err := checkClaimDecodes(item.Name, tokenAttributeSample(item)); err != nil {
+			return fmt.Errorf("tokenAttributes entry %d: %w", i+1, err)
+		}
+	}
+	return nil
+}
+
+// Casdoor verifies its own JWTs by decoding them into Claims, whose embedded User
+// fields encoding/json matches case-insensitively. A claim whose value cannot be
+// decoded into a same-named field would be issued, then rejected by Casdoor's own
+// introspection and token checks. Test a representative value of the issued type.
+func checkClaimDecodes(name string, value interface{}) error {
+	payload, err := json.Marshal(map[string]interface{}{name: value})
+	if err != nil {
+		return nil
+	}
+	if err := json.Unmarshal(payload, &Claims{}); err != nil {
+		return fmt.Errorf("claim %q conflicts with a Casdoor token field of a different type", name)
+	}
+	return nil
+}
+
+func tokenFieldSample(field string) interface{} {
+	switch {
+	case strings.HasPrefix(field, "Properties."), field == "signinMethod", field == "provider":
+		return "x"
+	case field == "permissionNames":
+		return []string{"x"}
+	}
+	member, _ := reflect.TypeOf(User{}).FieldByName(field)
+	return claimSample(member.Type, 0).Interface()
+}
+
+func tokenAttributeSample(item *JwtItem) interface{} {
+	if item.Category == "Existing Field" {
+		switch {
+		case item.Value == "Roles", item.Value == "Permissions", item.Value == "permissionNames":
+			return []string{"x"}
+		case strings.HasPrefix(item.Value, "Properties."):
+			return "x"
+		}
+		return tokenFieldSample(item.Value)
+	}
+	switch item.Type {
+	case "JSON":
+		var value interface{}
+		_ = json.Unmarshal([]byte(item.Value), &value)
+		return value
+	case "String":
+		return "x"
+	}
+	return []string{"x"}
+}
+
+// claimSample builds a nonempty value so element and map types are exercised.
+func claimSample(kind reflect.Type, depth int) reflect.Value {
+	value := reflect.New(kind).Elem()
+	if depth > 3 {
+		return value
+	}
+	switch kind.Kind() {
+	case reflect.String:
+		value.SetString("x")
+	case reflect.Bool:
+		value.SetBool(true)
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		value.SetInt(1)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		value.SetUint(1)
+	case reflect.Float32, reflect.Float64:
+		value.SetFloat(1)
+	case reflect.Slice:
+		if kind.Elem().Kind() != reflect.Uint8 {
+			value = reflect.Append(reflect.MakeSlice(kind, 0, 1), claimSample(kind.Elem(), depth+1))
+		}
+	case reflect.Map:
+		if kind.Key().Kind() == reflect.String {
+			value = reflect.MakeMap(kind)
+			value.SetMapIndex(reflect.ValueOf("x").Convert(kind.Key()), claimSample(kind.Elem(), depth+1))
+		}
+	case reflect.Ptr:
+		value = reflect.New(kind.Elem())
+		value.Elem().Set(claimSample(kind.Elem(), depth+1))
+	}
+	return value
+}
+
+// Partial updates validate the effective claim configuration, without requiring
+// unrelated omitted fields or trusting claim fields that will not be written.
+func validateUpdatedCustomClaimConfiguration(application, previous *Application, columns []string) error {
+	effective := *previous
+	if len(columns) == 0 {
+		return validateCustomClaimConfiguration(application)
+	}
+	for _, column := range columns {
+		if column == "token_fields" {
+			effective.TokenFields = application.TokenFields
+		}
+		if column == "token_attributes" {
+			effective.TokenAttributes = application.TokenAttributes
+		}
+	}
+	return validateCustomClaimConfiguration(&effective)
+}
