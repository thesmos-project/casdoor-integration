diff --git a/object/application_brand_test.go b/object/application_brand_test.go
new file mode 100644
index 0000000..c25ebf9
--- /dev/null
+++ b/object/application_brand_test.go
@@ -0,0 +1,50 @@
+// Part of Casdoor, licensed under the Apache License 2.0.
+// Modified by the Thesmos integration contributors in 2026. See https://github.com/thesmos-project/casdoor-integration/blob/main/docs/PATCHES.md
+
+package object
+
+import "testing"
+
+func TestSharedApplicationTakesTheServingOrganizationBrand(t *testing.T) {
+	shared := func(organization *Organization) *Application {
+		return &Application{
+			IsShared: true, Organization: organization.Name, OrganizationObj: organization,
+			Logo: "https://home.example/logo.svg", LogoDark: "https://home.example/logo-dark.svg",
+			Title: "Home", Favicon: "https://home.example/favicon.svg",
+			ThemeData: &ThemeData{ColorPrimary: "#111111", IsEnabled: true},
+		}
+	}
+
+	brand := &ThemeData{ColorPrimary: "#1f5f8b", IsEnabled: true}
+	tenant := &Organization{Name: "tidewater", DisplayName: "Tidewater Plumbing",
+		Logo: "https://tidewater.example/logo.svg", Favicon: "https://tidewater.example/favicon.svg", ThemeData: brand}
+	application := shared(tenant)
+	applyServingOrganizationBrand(application, "built-in")
+	if application.Logo != tenant.Logo || application.LogoDark != "" || application.Favicon != tenant.Favicon ||
+		application.Title != "Tidewater Plumbing" || application.ThemeData != brand {
+		t.Fatalf("served for its organization, the application shows %+v", application)
+	}
+
+	// What the organization leaves empty keeps the application's.
+	plain := &Organization{Name: "plain", DisplayName: "Plain Company", ThemeData: &ThemeData{ColorPrimary: "#222222"}}
+	application = shared(plain)
+	applyServingOrganizationBrand(application, "built-in")
+	if application.Logo != "https://home.example/logo.svg" || application.Title != "Home" || application.ThemeData.ColorPrimary != "#111111" {
+		t.Fatalf("an unbranded organization changed the application: %+v", application)
+	}
+
+	// Served for its own organization, or not shared, it keeps its brand.
+	home := &Organization{Name: "built-in", DisplayName: "Built-in", Logo: "https://other.example/logo.svg"}
+	application = shared(home)
+	applyServingOrganizationBrand(application, "built-in")
+	if application.Logo != "https://home.example/logo.svg" {
+		t.Fatal("the home organization replaced the application's own brand")
+	}
+	application = shared(tenant)
+	application.IsShared = false
+	applyServingOrganizationBrand(application, "built-in")
+	if application.Logo != "https://home.example/logo.svg" {
+		t.Fatal("an application that is not shared took an organization's brand")
+	}
+	applyServingOrganizationBrand(nil, "built-in")
+}
diff --git a/object/application_util.go b/object/application_util.go
index 6063fdc..8a3dd68 100644
--- a/object/application_util.go
+++ b/object/application_util.go
@@ -63,6 +63,37 @@ func extendApplicationWithOrg(application *Application) (err error) {
 	return
 }
 
+// applyServingOrganizationBrand gives a shared application served for one of
+// the organizations that use it that organization's brand: its logo, favicon,
+// name and theme replace the application's, so each organization's people
+// sign in on their own brand. What the organization leaves empty keeps the
+// application's. homeOrganization is the organization that owns the
+// application; served for it, the application keeps its own brand.
+func applyServingOrganizationBrand(application *Application, homeOrganization string) {
+	if application == nil || !application.IsShared {
+		return
+	}
+	organization := application.OrganizationObj
+	if organization == nil || organization.Name == homeOrganization {
+		return
+	}
+	// the logo and the name it carries go together: without a logo of its
+	// own, the organization keeps the application's logo and title
+	if organization.Logo != "" {
+		application.Logo = organization.Logo
+		application.LogoDark = organization.LogoDark
+		if organization.DisplayName != "" {
+			application.Title = organization.DisplayName
+		}
+	}
+	if organization.Favicon != "" {
+		application.Favicon = organization.Favicon
+	}
+	if organization.ThemeData != nil && organization.ThemeData.IsEnabled {
+		application.ThemeData = organization.ThemeData
+	}
+}
