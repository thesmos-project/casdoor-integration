+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package certificate
+
+import (
+	"crypto/ecdsa"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/casdoor/casdoor/proxy"
+	"github.com/go-acme/lego/v4/lego"
+)
+
+type evaluationAcmeTransport func(*http.Request) (*http.Response, error)
+
+func (transport evaluationAcmeTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	return transport(request)
+}
+
+func TestEvaluationAcmeClientAccountAndDirectory(t *testing.T) {
+	key, err := generateEccKey()
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := encodeEccKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := proxy.ProxyHttpClient
+	t.Cleanup(func() { proxy.ProxyHttpClient = original })
+	for _, staging := range []bool{true, false} {
+		expected := lego.LEDirectoryProduction
+		if staging {
+			expected = lego.LEDirectoryStaging
+		}
+		requests := 0
+		proxy.ProxyHttpClient = &http.Client{Transport: evaluationAcmeTransport(func(request *http.Request) (*http.Response, error) {
+			requests++
+			if request.URL.String() != expected || request.Method != http.MethodGet {
+				t.Fatalf("unexpected ACME directory request method/endpoint")
+			}
+			return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": {"application/json"}},
+				Body: io.NopCloser(strings.NewReader(`{"newNonce":"https://acme.invalid/nonce","newAccount":"https://acme.invalid/account","newOrder":"https://acme.invalid/order","revokeCert":"https://acme.invalid/revoke","keyChange":"https://acme.invalid/key"}`)), Request: request}, nil
+		})}
+		client, account, err := getLegoClientAndAccount("operator@evaluation.invalid", encoded, staging)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if client == nil || requests != 1 || account.GetEmail() != "operator@evaluation.invalid" || !account.GetPrivateKey().(*ecdsa.PrivateKey).Equal(key) {
+			t.Fatal("ACME client lost directory selection or signing account")
+		}
+	}
+}
