+// parseSshHostKeys reads the public host keys a syncer trusts for its SSH server. Each line
+// is either an authorized_keys entry ("ssh-ed25519 AAAA...") or a known_hosts entry, such as
+// the output of ssh-keyscan ("host ssh-ed25519 AAAA..."); the host part of a known_hosts
+// entry is ignored, as the syncer always dials its own configured host.
+func parseSshHostKeys(hostKey string) ([]ssh.PublicKey, error) {
+	var keys []ssh.PublicKey
+	for _, line := range strings.Split(hostKey, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+
+		key, _, _, _, err := ssh.ParseAuthorizedKey([]byte(line))
+		if err != nil {
+			_, _, key, _, _, err = ssh.ParseKnownHosts([]byte(line))
+		}
+		if err != nil {
+			return nil, fmt.Errorf("the SSH host key is not a valid public key line: %s", line)
+		}
+		keys = append(keys, key)
+	}
+
+	if len(keys) == 0 {
+		return nil, fmt.Errorf("the SSH host key is required to verify the SSH server: set it to the server's public host key, for example the output of ssh-keyscan")
+	}
+	return keys, nil
+}
+
+// sshHostKeyConfig returns the host key check of a syncer's SSH connection. Without it, any
+// machine on the network path could pose as the SSH server, receive the SSH password and
+// read the tunnelled database traffic. The client offers only the algorithms of the
+// configured keys, so that the server presents one of them.
+func sshHostKeyConfig(hostKey string) (ssh.HostKeyCallback, []string, error) {
+	keys, err := parseSshHostKeys(hostKey)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	var algorithms []string
+	seen := map[string]bool{}
+	for _, key := range keys {
+		keyAlgorithms := []string{key.Type()}
+		if key.Type() == ssh.KeyAlgoRSA {
+			keyAlgorithms = []string{ssh.KeyAlgoRSASHA512, ssh.KeyAlgoRSASHA256, ssh.KeyAlgoRSA}
+		}
+		for _, algorithm := range keyAlgorithms {
+			if !seen[algorithm] {
+				seen[algorithm] = true
+				algorithms = append(algorithms, algorithm)
+			}
+		}
+	}
