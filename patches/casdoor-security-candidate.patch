diff --git a/object/thesmos_saml_security_test.go b/object/thesmos_saml_security_test.go
new file mode 100644
index 0000000..5618221
--- /dev/null
+++ b/object/thesmos_saml_security_test.go
@@ -0,0 +1,196 @@
+// Copyright 2026 The Thesmos integration contributors.
+// Added for the Thesmos integration security evaluation, 2026-10-06.
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
