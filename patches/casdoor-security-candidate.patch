+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+
+package object
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"math/big"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/beevik/etree"
+	dsig "github.com/russellhaering/goxmldsig"
+)
+
+func evaluationSAMLKey(t *testing.T) (*dsig.TLSCertKeyStore, string) {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	serial, err := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: serial, NotBefore: now.Add(-time.Hour),
+		NotAfter: now.Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature}
+	cert, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &dsig.TLSCertKeyStore{PrivateKey: key, Certificate: [][]byte{cert}},
+		string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: cert}))
+}
+
+// Construct and sign real XML; the production parser verifies signatures and
+// conditions. No private key or encoded response is logged or saved.
+func evaluationSAMLResponse(t *testing.T, key dsig.X509KeyStore, acs string,
+	mutate func(*etree.Element), assertionOnly bool, tamper bool) string {
+	t.Helper()
+	now := time.Now()
+	doc := etree.NewDocument()
+	r := doc.CreateElement("samlp:Response")
+	r.CreateAttr("xmlns:samlp", "urn:oasis:names:tc:SAML:2.0:protocol")
+	r.CreateAttr("xmlns:saml", "urn:oasis:names:tc:SAML:2.0:assertion")
+	r.CreateAttr("ID", "_response")
+	r.CreateAttr("Version", "2.0")
+	r.CreateAttr("IssueInstant", now.UTC().Format(time.RFC3339))
+	r.CreateAttr("Destination", acs)
+	r.CreateAttr("InResponseTo", "_request")
+	r.CreateElement("saml:Issuer").SetText("https://idp.evaluation.invalid")
+	r.CreateElement("samlp:Status").CreateElement("samlp:StatusCode").CreateAttr("Value", "urn:oasis:names:tc:SAML:2.0:status:Success")
+	a := r.CreateElement("saml:Assertion")
+	a.CreateAttr("ID", "_assertion")
+	a.CreateAttr("Version", "2.0")
+	a.CreateAttr("IssueInstant", now.UTC().Format(time.RFC3339))
+	a.CreateElement("saml:Issuer").SetText("https://idp.evaluation.invalid")
+	s := a.CreateElement("saml:Subject")
+	s.CreateElement("saml:NameID").SetText("immutable-evaluation-subject")
+	confirmation := s.CreateElement("saml:SubjectConfirmation")
+	confirmation.CreateAttr("Method", "urn:oasis:names:tc:SAML:2.0:cm:bearer")
+	data := confirmation.CreateElement("saml:SubjectConfirmationData")
+	data.CreateAttr("Recipient", acs)
+	data.CreateAttr("InResponseTo", "_request")
+	data.CreateAttr("NotOnOrAfter", now.Add(5*time.Minute).UTC().Format(time.RFC3339))
+	c := a.CreateElement("saml:Conditions")
+	c.CreateAttr("NotBefore", now.Add(-time.Minute).UTC().Format(time.RFC3339))
+	c.CreateAttr("NotOnOrAfter", now.Add(5*time.Minute).UTC().Format(time.RFC3339))
+	c.CreateElement("saml:AudienceRestriction").CreateElement("saml:Audience").SetText(acs)
+	attr := a.CreateElement("saml:AttributeStatement").CreateElement("saml:Attribute")
+	attr.CreateAttr("Name", "email")
+	attr.CreateElement("saml:AttributeValue").SetText("reader@evaluation.invalid")
+	if mutate != nil {
+		mutate(r)
+	}
+	if key != nil {
+		ctx := dsig.NewDefaultSigningContext(key)
+		ctx.Canonicalizer = dsig.MakeC14N10ExclusiveCanonicalizerWithPrefixList("")
+		target := r
+		if assertionOnly {
+			target = a
+			target.CreateAttr("xmlns:saml", "urn:oasis:names:tc:SAML:2.0:assertion")
+		}
+		signed, err := ctx.SignEnveloped(target)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if assertionOnly {
+			r.RemoveChild(a)
+			r.AddChild(signed)
+		} else {
+			doc.SetRoot(signed)
+		}
+	}
+	if tamper {
+		doc.Root().FindElement(".//saml:NameID").SetText("attacker")
+	}
+	raw, err := doc.WriteToBytes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// ParseSamlResponse expects the response's form-escaped representation.
+	return url.QueryEscape(base64.StdEncoding.EncodeToString(raw))
+}
+
+func TestEvaluationSAMLTrustAndConditions(t *testing.T) {
+	trusted, certificate := evaluationSAMLKey(t)
+	attacker, _ := evaluationSAMLKey(t)
+	provider := &Provider{Name: "evaluation", IdP: certificate,
+		Endpoint: "https://idp.evaluation.invalid/sso", IssuerUrl: "https://idp.evaluation.invalid",
+		UserMapping: map[string]string{"email": "email"}}
+	const host = "sp.evaluation.invalid"
+	_, origin := getOriginFromHost(host)
+	acs := origin + "/api/acs"
+	previous := SamlAssertionStore
+	t.Cleanup(func() { SamlAssertionStore = previous })
+	cases := []struct {
+		name                            string
+		key                             dsig.X509KeyStore
+		mutate                          func(*etree.Element)
+		request                         string
+		assertionOnly, tamper, accepted bool
+		errorContains                   string
+	}{
+		{name: "trusted response", key: trusted, request: "_request", accepted: true},
+		{name: "trusted assertion", key: trusted, request: "_request", assertionOnly: true, accepted: true},
+		{name: "embedded attacker certificate", key: attacker, request: "_request", errorContains: "certificate"},
+		{name: "unsigned response", request: "_request"},
+		{name: "signed content tampering", key: trusted, request: "_request", tamper: true},
+		{name: "wrong audience", key: trusted, request: "_request", mutate: func(r *etree.Element) {
+			r.FindElement(".//saml:Audience").SetText("https://other.evaluation.invalid/api/acs")
+		}, errorContains: "AudienceRestriction"},
+		{name: "expired conditions", key: trusted, request: "_request", mutate: func(r *etree.Element) {
+			r.FindElement(".//saml:Conditions").CreateAttr("NotOnOrAfter", time.Now().Add(-time.Minute).UTC().Format(time.RFC3339))
+		}, errorContains: "validity period"},
+		{name: "future conditions", key: trusted, request: "_request", mutate: func(r *etree.Element) {
+			r.FindElement(".//saml:Conditions").CreateAttr("NotBefore", time.Now().Add(time.Hour).UTC().Format(time.RFC3339))
+		}, errorContains: "validity period"},
+		{name: "wrong recipient", key: trusted, request: "_request", mutate: func(r *etree.Element) {
+			r.FindElement(".//saml:SubjectConfirmationData").CreateAttr("Recipient", "https://other.evaluation.invalid/api/acs")
+		}, errorContains: "Recipient"},
+		{name: "wrong request", key: trusted, request: "_different_request", errorContains: "InResponseTo"},
+		{name: "unsolicited response", key: trusted, request: "", errorContains: "InResponseTo"},
+		{name: "wrong issuer", key: trusted, request: "_request", mutate: func(r *etree.Element) {
+			r.FindElement("saml:Issuer").SetText("https://other.evaluation.invalid")
+		}, errorContains: "Issuer"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			SamlAssertionStore = &memorySamlAssertionStore{expiries: map[string]time.Time{}}
+			encoded := evaluationSAMLResponse(t, tc.key, acs, tc.mutate, tc.assertionOnly, tc.tamper)
+			user, err := ParseSamlResponse(encoded, provider, host, tc.request)
+			if tc.accepted {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if user.Id != "immutable-evaluation-subject" || user.Email != "reader@evaluation.invalid" {
+					t.Fatal("trusted identity not preserved")
+				}
+				if _, err := ParseSamlResponse(encoded, provider, host, tc.request); err == nil || !strings.Contains(err.Error(), "already been used") {
+					t.Fatal("replay accepted or rejected outside replay guard")
+				}
+			} else {
+				if err == nil {
+					t.Fatal("invalid response accepted")
+				}
+				if tc.errorContains != "" && !strings.Contains(err.Error(), tc.errorContains) {
+					t.Fatalf("unexpected rejection: %v", err)
+				}
+				if len(SamlAssertionStore.(*memorySamlAssertionStore).expiries) != 0 {
+					t.Fatal("rejected assertion consumed replay state")
+				}
+			}
+		})
+	}
+	t.Run("missing configured certificate", func(t *testing.T) {
+		missing := *provider
+		missing.IdP = ""
+		if _, err := ParseSamlResponse(evaluationSAMLResponse(t, attacker, acs, nil, false, false), &missing, host, "_request"); err == nil || !strings.Contains(err.Error(), "is empty") {
+			t.Fatal("missing configured trust accepted")
+		}
+	})
+}
