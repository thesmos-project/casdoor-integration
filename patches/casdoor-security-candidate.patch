+package object
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/rsa"
+	"net"
+	"strings"
+	"testing"
+
+	"golang.org/x/crypto/ssh"
+)
+
+func testSshSigner(t *testing.T, rsaKey bool) ssh.Signer {
+	t.Helper()
+	var signer ssh.Signer
+	var err error
+	if rsaKey {
+		var key *rsa.PrivateKey
+		key, err = rsa.GenerateKey(rand.Reader, 2048)
+		if err == nil {
+			signer, err = ssh.NewSignerFromKey(key)
+		}
+	} else {
+		var key ed25519.PrivateKey
+		_, key, err = ed25519.GenerateKey(rand.Reader)
+		if err == nil {
+			signer, err = ssh.NewSignerFromKey(key)
+		}
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return signer
+}
+
+// startTestSshServer accepts password "secret" for user "syncer" and presents hostKeys.
+func startTestSshServer(t *testing.T, hostKeys ...ssh.Signer) (string, int) {
+	t.Helper()
+	config := &ssh.ServerConfig{
+		PasswordCallback: func(conn ssh.ConnMetadata, password []byte) (*ssh.Permissions, error) {
+			if conn.User() == "syncer" && string(password) == "secret" {
+				return nil, nil
+			}
+			return nil, ssh.ErrNoAuth
+		},
+	}
+	for _, hostKey := range hostKeys {
+		config.AddHostKey(hostKey)
+	}
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				serverConn, channels, requests, err := ssh.NewServerConn(conn, config)
+				if err != nil {
+					conn.Close()
+					return
+				}
+				defer serverConn.Close()
+				go ssh.DiscardRequests(requests)
+				for channel := range channels {
+					channel.Reject(ssh.Prohibited, "test server")
+				}
+			}()
+		}
+	}()
+
+	address := listener.Addr().(*net.TCPAddr)
+	return address.IP.String(), address.Port
+}
+
+func authorizedKeyLine(signer ssh.Signer) string {
+	return strings.TrimSpace(string(ssh.MarshalAuthorizedKey(signer.PublicKey())))
+}
+
+func TestSyncerSshTunnelVerifiesTheServerHostKey(t *testing.T) {
+	serverKey := testSshSigner(t, false)
+	otherKey := testSshSigner(t, false)
+	host, port := startTestSshServer(t, serverKey)
+
+	tests := []struct {
+		name          string
+		hostKey       string
+		errorContains string
+	}{
+		{name: "authorized_keys line", hostKey: authorizedKeyLine(serverKey)},
+		{name: "ssh-keyscan line", hostKey: "# scanned\n[" + host + "]:2222 " + authorizedKeyLine(serverKey) + "\n"},
+		{name: "one of several keys", hostKey: authorizedKeyLine(otherKey) + "\n" + authorizedKeyLine(serverKey)},
+		{name: "missing key", hostKey: "  \n", errorContains: "host key is required"},
+		{name: "invalid key", hostKey: "ssh-ed25519 not-base64", errorContains: "not a valid public key"},
+		{name: "another server's key", hostKey: authorizedKeyLine(otherKey), errorContains: "does not match"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			client, err := DialWithPassword("syncer", "secret", host, port, tt.hostKey)
+			if client != nil {
+				client.Close()
+			}
+			if tt.errorContains == "" {
+				if err != nil {
+					t.Fatalf("connection with the trusted host key failed: %v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.errorContains) {
+				t.Fatalf("got error %v, want one containing %q", err, tt.errorContains)
+			}
+		})
+	}
+}
+
+// A server with several host keys must present the configured one, so that pinning
+// its RSA key works when the server would otherwise offer Ed25519 first.
+func TestSyncerSshTunnelNegotiatesTheConfiguredKeyType(t *testing.T) {
+	ed25519Key := testSshSigner(t, false)
+	rsaKey := testSshSigner(t, true)
+	host, port := startTestSshServer(t, ed25519Key, rsaKey)
+
+	for name, trusted := range map[string]ssh.Signer{"RSA": rsaKey, "Ed25519": ed25519Key} {
+		client, err := DialWithPassword("syncer", "secret", host, port, authorizedKeyLine(trusted))
+		if err != nil {
+			t.Fatalf("%s host key: %v", name, err)
+		}
+		client.Close()
+	}
+}
