# Derived from Casdoor v4.15.0 conf/app.conf; modified for the integration image.
# Set dataSourceName, origin and originFrontend before use.
# Secure startup reads the initial administrator password from this file.
bootstrapAdminPasswordFile = /conf/admin-password
appname = casdoor
httpport = 8000
runmode = prod
copyrequestbody = true
driverName = postgres
dataSourceName = "user=casdoor password=REPLACE_WITH_PRIVATE_PASSWORD host=YOUR_DATABASE_HOST port=5432 sslmode=verify-full sslrootcert=/conf/db-ca.pem dbname=casdoor"
dbName = casdoor
tableNamePrefix =
showSql = false
redisEndpoint =
defaultStorageProvider =
isCloudIntranet = false
authState = "casdoor"
socks5Proxy = "127.0.0.1:10808"
verificationCodeTimeout = 10
initScore = 0
logPostOnly = true
isUsernameLowered = false
origin = "http://localhost:19080"
originFrontend = "http://localhost:19080"
staticBaseUrl = "https://cdn.casbin.org"
isDemoMode = false
batchSize = 100
showGithubCorner = false
forceLanguage = ""
defaultLanguage = "en"
defaultApplication = "app-built-in"
maxItemsForFlatMenu = 7
enableErrorMask = false
enableGzip = true
inactiveTimeoutMinutes =
ldapServerPort =
ldapsCertId = ""
ldapsServerPort =
radiusServerPort =
radiusDefaultOrganization = "built-in"
radiusSecret =
quota = {"organization": -1, "user": -1, "application": -1, "provider": -1}
logConfig = {"adapter":"console","level":4}
initDataNewOnly = true
initDataFile = ""
frontendBaseDir = "../cc_0"
