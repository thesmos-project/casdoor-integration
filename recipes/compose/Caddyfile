# Public HTTPS entry point for Casdoor. Caddy obtains and renews a certificate
# for CASDOOR_DOMAIN automatically; "localhost" uses its local authority.
{$CASDOOR_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy casdoor:8000
}
